<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Gather — Campus events</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/style.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-lg top-nav"><div class="container"><a class="navbar-brand" href="/"><span class="brand-symbol">g</span> gather<span class="brand-period">.</span></a><div class="ms-auto d-flex align-items-center gap-3"><a class="nav-link d-none d-sm-block" href="#events">Explore events</a><button class="btn btn-dark btn-sm host-button" data-bs-toggle="modal" data-bs-target="#event-modal">Host an event <span>＋</span></button></div></div></nav>
  <main>
    <section class="hero"><div class="container hero-inner"><div class="hero-copy"><span class="hero-kicker"><i></i> CAMPUS LIFE, HAPPENING NOW</span><h1>Find your people.<br>Make <em>something</em> happen.</h1><p>From big ideas to good times, find the events that make college yours.</p><a class="btn btn-light hero-button" href="#events">Explore what's on <span>↓</span></a></div><div class="hero-art" aria-hidden="true"><div class="art-circle circle-one"></div><div class="art-circle circle-two"></div><div class="poster poster-back"><span>OPEN MIC</span><b>YOUR<br>STAGE</b><i>THU · 7 PM</i></div><div class="poster poster-front"><span>✳</span><b>MAKE<br>WAVES</b><i>CAMPUS FEST · 2026</i></div><div class="art-sticker">SHOW<br>UP ✦</div></div><div class="hero-foot"><span>GOOD THINGS HAPPEN WHEN WE GET TOGETHER</span><span>SCROLL TO DISCOVER ↓</span></div></div></section>
    <section class="event-section container" id="events"><div class="section-head"><div><p class="section-kicker">THE CAMPUS CALENDAR</p><h2>Happening around you<span>.</span></h2><p class="section-sub">A few good reasons to step away from your desk.</p></div><div class="search-wrap"><span>⌕</span><input id="event-search" type="search" placeholder="Search events" aria-label="Search events"></div></div>
      <div class="category-row"><button class="category-chip selected" data-category="all">All events</button><% categories.forEach(category => { %><button class="category-chip" data-category="<%= category %>"><%= category %></button><% }) %></div>
      <div class="event-grid" id="event-grid"><% events.forEach((event, index) => { const date = new Date(event.event_date + 'T00:00:00'); const palettes = ['coral','violet','mint','yellow']; %><article class="event-card" data-category="<%= event.category %>" data-search="<%= (event.title+' '+event.category+' '+event.location).toLowerCase() %>"><div class="event-visual <%= palettes[index % palettes.length] %>"><span class="visual-label"><%= event.category.toUpperCase() %></span><span class="visual-art" aria-hidden="true"><%= ['✳','✦','◈','✺'][index % 4] %></span><div class="date-stamp"><strong><%= date.getDate() %></strong><span><%= date.toLocaleDateString('en-US',{month:'short'}).toUpperCase() %></span></div><span class="visual-index">NO. 0<%= index+1 %></span></div><div class="event-info"><div class="event-meta"><span>◷ &nbsp;<%= event.event_time %></span><span><%= event.spots_left %> spots left</span></div><h3><%= event.title %></h3><p class="event-location">⌖ &nbsp;<%= event.location %></p><p class="event-description"><%= event.description %></p><button class="register-link" data-event-id="<%= event.id %>" data-event-title="<%= event.title %>" <%= event.spots_left===0?'disabled':'' %>><%= event.spots_left===0?'Event full':'Get your spot' %> <span>↗</span></button><div class="event-management"><span>Organizer tools</span><div><button data-action="edit" data-event-id="<%= event.id %>">Edit</button><button data-action="delete" data-event-id="<%= event.id %>">Delete</button></div></div></div></article><% }) %></div>
      <div class="no-events <%= events.length ? 'd-none' : '' %>" id="no-events"><span>✳</span><h3>No events just yet</h3><p>Be the first to add something to the calendar.</p><button class="btn btn-dark btn-sm" data-bs-toggle="modal" data-bs-target="#event-modal">Create an event</button></div>
      <div class="no-results d-none" id="no-results">No events match that search. Try another category or keyword.</div>
    </section>
    <section class="host-banner"><div class="container host-banner-inner"><div><p class="section-kicker">GOT SOMETHING IN MIND?</p><h2>Bring your idea<br>to the campus.</h2></div><button class="btn btn-light" data-bs-toggle="modal" data-bs-target="#event-modal">Post an event <span>↗</span></button><div class="banner-shape" aria-hidden="true">✳</div></div></section>
  </main>
  <footer class="container page-footer"><a class="navbar-brand" href="/">gather<span class="brand-period">.</span></a><span>Made for campus, by campus. &nbsp;© <%= new Date().getFullYear() %></span></footer>

  <div class="modal fade" id="register-modal" tabindex="-1" aria-labelledby="register-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form id="registration-form"><div class="modal-header"><div><p class="section-kicker">SAVE YOUR SEAT</p><h2 class="modal-title" id="register-title">Register for event</h2><p class="modal-subtitle" id="register-event-title"></p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><input type="hidden" id="register-event-id"><label class="form-label" for="student-name">Your name</label><input class="form-control" id="student-name" maxlength="100" placeholder="Alex Morgan" required><label class="form-label mt-3" for="student-email">College email</label><input class="form-control" id="student-email" type="email" maxlength="254" placeholder="alex@college.edu" required><div class="feedback" id="registration-feedback" role="status"></div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Maybe later</button><button type="submit" class="btn btn-dark" id="register-submit">Confirm registration</button></div></form></div></div></div>
  <div class="modal fade" id="event-modal" tabindex="-1" aria-labelledby="event-modal-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><form id="event-form"><div class="modal-header"><div><p class="section-kicker">ADD TO THE CALENDAR</p><h2 class="modal-title" id="event-modal-title">Host an event</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><label class="form-label" for="event-title">Event name</label><input class="form-control" id="event-title" maxlength="100" placeholder="e.g. Design club meetup" required><div class="row"><div class="col-sm-6"><label class="form-label mt-3" for="event-category">Category</label><select class="form-select" id="event-category"><% categories.forEach(category => { %><option><%= category %></option><% }) %></select></div><div class="col-sm-6"><label class="form-label mt-3" for="event-capacity">Attendee limit</label><input class="form-control" id="event-capacity" type="number" min="1" max="10000" value="50" required></div></div><div class="row"><div class="col-sm-6"><label class="form-label mt-3" for="event-date">Date</label><input class="form-control" id="event-date" type="date" required></div><div class="col-sm-6"><label class="form-label mt-3" for="event-time">Start time</label><input class="form-control" id="event-time" type="time" required></div></div><label class="form-label mt-3" for="event-location">Location</label><input class="form-control" id="event-location" maxlength="120" placeholder="Student union, Room 204" required><label class="form-label mt-3" for="event-description">A little about it</label><textarea class="form-control" id="event-description" rows="3" maxlength="1000" placeholder="What should people know?" required></textarea><div class="feedback" id="event-feedback" role="alert"></div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-dark" id="event-submit">Publish event</button></div></form></div></div></div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="/app.js"></script>
</body>
</html>
